# Copy to config.env and edit. Every value can also be set in the environment.

# --- LLM ---------------------------------------------------------------------
# ASS_LLM_CMD="$ASS_ROOT/llm/openai_compatible.sh"
# ASS_LLM_BASE_URL="https://your-provider.example/v1"
# ASS_LLM_API_KEY="..."            # keep this file out of version control
# ASS_LLM_MODEL="your-model-name"
# ASS_LLM_TEMPERATURE=0.3
# ASS_LLM_MAX_TOKENS=2000

# --- Triggers ------------------------------------------------------------------
# ASS_CONSECUTIVE_FAILURES=3
# ASS_WINDOW=10
# ASS_WINDOW_FAILURE_RATE=50
# ASS_ERROR_REGEX="No such file or directory|not found|Permission denied|Connection refused"
# ASS_SLOWDOWN_FACTOR=2
# ASS_BASELINE_RUNS=20

# --- Safety pipeline -----------------------------------------------------------
# ASS_SANDBOX=docker
# ASS_SANDBOX_IMAGE="ubuntu:22.04"
# ASS_SANDBOX_TIMEOUT=60
# ASS_SANDBOX_SETUP="$ASS_ROOT/examples/backup/sandbox_setup.sh"
